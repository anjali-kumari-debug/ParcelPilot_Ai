# Copy to backend/.env (or a repo-root .env) and fill in. Both are gitignored.
#
# Free cloud LLM (Groq) — default chat provider. Get a key at:
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (check https://console.groq.com/docs/models for the live list):
# GROQ_CHAT_MODEL=openai/gpt-oss-120b       # default; smarter, tool-calling
# GROQ_CHAT_MODEL=openai/gpt-oss-20b        # faster / lighter
#
# Local Ollama is OFF by default (hosted/Render must keep this false).
# ENABLE_OLLAMA=false
#
# Local-only: turn Ollama on, then pick chat and/or embeddings:
# ENABLE_OLLAMA=true
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=fastembed          # keep fastembed, or set ollama
# OLLAMA_HOST=http://localhost:11434
